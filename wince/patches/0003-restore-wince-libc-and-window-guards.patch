diff --git a/Common/Source/xcs/Util/WStringAPI.hxx b/Common/Source/xcs/Util/WStringAPI.hxx
--- a/Common/Source/xcs/Util/WStringAPI.hxx
+++ b/Common/Source/xcs/Util/WStringAPI.hxx
@@ -2,5 +2,9 @@
 static inline int
 StringCollate(const wchar_t *a, const wchar_t *b)
 {
+#ifdef UNDER_CE
+  return wcscmp(a, b);
+#else
   return wcscoll(a, b);
+#endif
 }
diff --git a/Common/Source/xcs/Util/StringAPI.hxx b/Common/Source/xcs/Util/StringAPI.hxx
--- a/Common/Source/xcs/Util/StringAPI.hxx
+++ b/Common/Source/xcs/Util/StringAPI.hxx
@@ -2,5 +2,9 @@
 static inline int
 StringCollate(const char *a, const char *b)
 {
+#ifdef UNDER_CE
+  return strcmp(a, b);
+#else
   return strcoll(a, b);
+#endif
 }
