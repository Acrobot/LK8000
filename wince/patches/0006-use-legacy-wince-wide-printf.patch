diff --git a/Common/Source/MessageLog.cpp b/Common/Source/MessageLog.cpp
--- a/Common/Source/MessageLog.cpp
+++ b/Common/Source/MessageLog.cpp
@@ -125,24 +125,36 @@
 void StartupStoreV(const wchar_t* fmt, va_list args)
 {
+#ifdef UNDER_CE
+  // The WinCE CRT exposes the legacy bounded _vsntprintf API rather than
+  // the C99-style four-argument vswprintf used by modern libcs.
+  TCHAR buf[1024];
+  _vsntprintf(buf, sizeof(buf) / sizeof(buf[0]), fmt, args);
+  buf[(sizeof(buf) / sizeof(buf[0])) - 1] = L'\0';
+
+  TrimRight(buf);
+  std::string utf8_str = to_utf8(buf);
+  StartupStoreWrite(utf8_str.c_str());
+#else
   va_list args_copy;
   va_copy(args_copy, args);
 
   int size = vswprintf(nullptr, 0, fmt, args_copy);
   va_end(args_copy);
 
   if (size < 0) {
     return;
   }
 
   auto buffer = std::make_unique<wchar_t[]>(size + 1);
   wchar_t* buf = buffer.get();
 
   vswprintf(buf, size + 1, fmt, args);
   buf[size] = L'\0';
 
   TrimRight(buf);
 
   std::string utf8_str = to_utf8(buf);
 
   StartupStoreWrite(utf8_str.c_str());
+#endif
 }
