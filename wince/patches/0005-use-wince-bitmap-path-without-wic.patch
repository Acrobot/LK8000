diff --git a/Common/Source/Screen/LKBitmap.cpp b/Common/Source/Screen/LKBitmap.cpp
--- a/Common/Source/Screen/LKBitmap.cpp
+++ b/Common/Source/Screen/LKBitmap.cpp
@@ -17,9 +17,11 @@
 #include "MessageLog.h"
 
-#ifdef _WIN32
+#if defined(_WIN32) && !defined(UNDER_CE)
 #include "Screen/GDI/WICImageLoad.h"
 #include "Screen/GDI/WICContext.h"
-#else
+#endif
+
+#ifndef _WIN32
 #include "resource_data.h"
 #endif
 
@@ -42,12 +44,16 @@
 bool LKBitmap::LoadFromFile(const TCHAR* FilePath) {
     Reset();
 #ifdef _WIN32
+#ifdef UNDER_CE
+    bitmap = (HBITMAP) SHLoadDIBitmap(FilePath);
+#else
     bitmap = (HBITMAP) LoadImage(GetModuleHandle(NULL), FilePath, IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE);
+#endif
     return IsDefined();
 #elif defined(ANDROID)
     return LoadFile(FilePath);
 #else
     return LoadPNGFile(FilePath);
 #endif
     return false;
 }
@@ -80,20 +86,27 @@
 bool LKBitmap::LoadFromMemory(const void* data, size_t size) {
   Reset();
   if (!data || size == 0) {
     return false;
   }
 #ifdef _WIN32
+#ifdef UNDER_CE
+  // WIC is a desktop Windows API and is unavailable on Pocket PC 2003.
+  // File/resource bitmaps still use the native WinCE image decoder; memory
+  // decoding will get a dedicated WinCE implementation before release.
+  return false;
+#else
   try {
     WICContext ctx;
     (*this) = ::LoadImageFromMemoryWIC(ctx, data, size);
     return IsDefined();
   }
   catch (std::exception& e) {
     StartupStore(_T("LoadFromMemory failed : %s"), to_tstring(e.what()).c_str());
     return false;
   }
+#endif
 #else
   Bitmap::Load(ConstBuffer<void>(data, size));
   return IsDefined();
 #endif
 }
