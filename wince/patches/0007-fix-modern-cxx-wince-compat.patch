diff --git a/Common/Source/Library/TimeFunctions.cpp b/Common/Source/Library/TimeFunctions.cpp
--- a/Common/Source/Library/TimeFunctions.cpp
+++ b/Common/Source/Library/TimeFunctions.cpp
@@ -9,11 +9,38 @@
 namespace {
 
 #ifdef _WIN32
+#ifdef UNDER_CE
+constexpr bool is_leap_year(int year) {
+  return (year % 4 == 0) && (year % 100 != 0 || year % 400 == 0);
+}
+
+constexpr int days_before_year(int year) {
+  --year;
+  return year * 365 + year / 4 - year / 100 + year / 400;
+}
+
+constexpr int days_before_month(int year, int month) {
+  constexpr int cumulative_days[12] = {
+      0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
+  return cumulative_days[month - 1] +
+         ((month > 2 && is_leap_year(year)) ? 1 : 0);
+}
+
+time_t timegm(struct tm* tp) {
+  const int year = tp->tm_year + 1900;
+  const int month = tp->tm_mon + 1;
+  const int days = days_before_year(year) - days_before_year(1970) +
+                   days_before_month(year, month) + tp->tm_mday - 1;
+  return time_t(days) * 86400 + time_t(tp->tm_hour) * 3600 +
+         time_t(tp->tm_min) * 60 + tp->tm_sec;
+}
+#else
 // timegm() is a GNU extension, not standard C)
 //    not available by default on MinGW / Windows 
 time_t timegm (struct tm *tp) {
   return _mkgmtime(tp);
 } 
+#endif
 
 #endif
 
